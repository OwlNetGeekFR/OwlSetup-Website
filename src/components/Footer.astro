---
import { site } from "../lib/site";
import { release } from "../lib/release";

const columns = [
  {
    title: "Produit",
    links: [
      { href: "/telecharger/", label: "Télécharger" },
      { href: "/fonctionnalites/", label: "Fonctionnalités" },
      { href: "/guide-installation/", label: "Guide d’installation" },
      { href: "/securite/", label: "Sécurité" },
    ],
  },
  {
    title: "Projet",
    links: [
      { href: site.repo, label: "Code source" },
      { href: release.notesUrl, label: "Notes de version" },
      { href: site.issues, label: "Assistance" },
      { href: site.kofi, label: "Soutenir sur Ko-fi", external: true },
    ],
  },
  {
    title: "Informations",
    links: [
      { href: site.privacy, label: "Confidentialité" },
      { href: site.license, label: "Licence" },
      { href: site.security, label: "Signaler une faille" },
    ],
  },
];
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">
        <img src="/assets/owlsetup-logo.png" alt="" width="36" height="36" loading="lazy">
        <span>OwlSetup</span>
      </a>
      <p>Installation, mise à jour et entretien de Windows, dans une application gratuite et open source.</p>
      <p class="footer-version">Version stable {release.version} · {release.publishedLabel}</p>
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li><a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="shell footer-bottom">
    <span>© 2026 OwlSetup · Un projet <a href={site.authorUrl}>OwlNetGeekFR</a></span>
    <span>Les marques et logos cités appartiennent à leurs détenteurs respectifs.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 9vw, 112px);
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 15px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
    padding-block: 56px 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
  }
  .footer-brand p { max-width: 340px; }
  .footer-version { margin-top: 12px; font-size: 14px; }
  h2 {
    margin-bottom: 14px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
  }
  ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  a:hover { color: var(--text); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 22px 28px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
  }
  .footer-bottom a { color: var(--text-2); }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
  }
</style>

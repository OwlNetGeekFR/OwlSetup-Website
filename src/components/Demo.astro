---
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import Sparkles from "@lucide/astro/icons/sparkles";
import PackageCheck from "@lucide/astro/icons/package-check";
import Cpu from "@lucide/astro/icons/cpu";
import FileClock from "@lucide/astro/icons/file-clock";
import MonitorCog from "@lucide/astro/icons/monitor-cog";
import Trash from "@lucide/astro/icons/trash";
import Layers from "@lucide/astro/icons/layers";
import Play from "@lucide/astro/icons/play";
import Plus from "@lucide/astro/icons/plus";
import Check from "@lucide/astro/icons/check";
import Minus from "@lucide/astro/icons/minus";
import Square from "@lucide/astro/icons/square";
import X from "@lucide/astro/icons/x";
import WindowsMark from "./WindowsMark.astro";

const apps = [
  { id: "chrome", name: "Google Chrome", desc: "Navigateur rapide", logo: "googlechrome.svg" },
  { id: "firefox", name: "Mozilla Firefox", desc: "Navigateur libre", logo: "firefox.svg" },
  { id: "sevenzip", name: "7-Zip", desc: "Compression de fichiers", logo: "sevenzip.svg" },
  { id: "vlc", name: "VLC media player", desc: "Lecteur multimédia", logo: "vlc.svg" },
  { id: "discord", name: "Discord", desc: "Messages et appels", logo: "discord.svg" },
  { id: "vscode", name: "Visual Studio Code", desc: "Éditeur de code", logo: "vscode.svg" },
  { id: "spotify", name: "Spotify", desc: "Musique et podcasts", logo: "spotify.svg" },
  { id: "bitwarden", name: "Bitwarden", desc: "Mots de passe", logo: "bitwarden.svg" },
  { id: "docker", name: "Docker Desktop", desc: "Conteneurs", logo: "docker.svg" },
];

const cleanup = [
  { icon: FileClock, title: "Fichiers temporaires", desc: "Fichiers provisoires des applications", size: 1.2, checked: true },
  { icon: MonitorCog, title: "Temporaires Windows", desc: "Résidus système inutilisés", size: 0.7, checked: true },
  { icon: Trash, title: "Corbeille", desc: "Fichiers déjà supprimés", size: 0.5, checked: true },
  { icon: Layers, title: "Anciens composants", desc: "Nettoyage Windows avancé", size: 1.6, checked: false },
];
const gigabytes = (value: number) => `${value.toLocaleString("fr-FR", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Go`;
const initialCleanup = cleanup.filter((item) => item.checked).reduce((sum, item) => sum + item.size, 0);
---
<div class="demo" data-demo>
  <div class="demo-bar">
    <img src="/assets/owlsetup-logo.png" alt="" width="20" height="20" loading="lazy">
    <span>OwlSetup</span>
    <span class="badge warning">Mode démo</span>
    <span class="win-controls" aria-hidden="true"><Minus size={16} /><Square size={13} /><X size={16} /></span>
  </div>

  <div class="demo-body">
    <div class="demo-side" role="tablist" aria-label="Sections de la démonstration" aria-orientation="vertical">
      <button type="button" role="tab" id="demo-tab-catalog" aria-controls="demo-catalog" aria-selected="true"><LayoutGrid aria-hidden="true" /><span>Catalogue</span></button>
      <button type="button" role="tab" id="demo-tab-updates" aria-controls="demo-updates" aria-selected="false" tabindex="-1"><RefreshCw aria-hidden="true" /><span>Mises à jour</span></button>
      <button type="button" role="tab" id="demo-tab-cleanup" aria-controls="demo-cleanup" aria-selected="false" tabindex="-1"><Sparkles aria-hidden="true" /><span>Nettoyage</span></button>
      <div class="demo-os"><WindowsMark size={18} /><span><strong>Windows 11</strong><small>Prêt à configurer</small></span></div>
    </div>

    <div class="demo-main">
      <section class="demo-panel" role="tabpanel" id="demo-catalog" aria-labelledby="demo-tab-catalog">
        <header class="panel-head">
          <div><small>Nouvelle configuration</small><h3>Choisissez vos logiciels</h3></div>
          <span class="count"><b data-demo-count>0</b> sélectionné(s)</span>
        </header>
        <div class="apps">
          {apps.map((app) => (
            <button type="button" class="app" data-demo-app={app.id} aria-pressed="false">
              <span class="logo-tile" data-brand={app.logo.replace(".svg", "")}><img src={`/assets/logos/${app.logo}`} alt="" width="34" height="34" loading="lazy"></span>
              <span><strong>{app.name}</strong><small>{app.desc}</small></span>
              <i aria-hidden="true"><Plus class="i-add" size={16} /><Check class="i-on" size={16} /></i>
            </button>
          ))}
        </div>
        <div class="dock" data-demo-dock hidden>
          <span><strong><span data-demo-count>0</span> logiciel(s)</strong> prêt(s) pour l’installation</span>
          <button type="button" class="btn btn-primary btn-sm" data-demo-run="install"><Play aria-hidden="true" />Installer</button>
        </div>
      </section>

      <section class="demo-panel" role="tabpanel" id="demo-updates" aria-labelledby="demo-tab-updates" hidden>
        <header class="panel-head">
          <div><small>Maintenance Windows</small><h3>Tout mettre à jour</h3></div>
        </header>
        <div class="update-list">
          <div><span class="icon-tile"><PackageCheck aria-hidden="true" /></span><span><strong>Logiciels installés</strong><small>Applications reconnues par WinGet</small></span><em>7 mises à jour</em></div>
          <div><span class="icon-tile cyan"><WindowsMark size={20} /></span><span><strong>Composants Windows</strong><small>Sécurité et qualité</small></span><em>2 disponibles</em></div>
          <div><span class="icon-tile violet"><Cpu aria-hidden="true" /></span><span><strong>Pilotes certifiés</strong><small>Distribués par Microsoft</small></span><em>À jour</em></div>
        </div>
        <button type="button" class="btn btn-primary run" data-demo-run="update"><Play aria-hidden="true" />Simuler la mise à jour</button>
      </section>

      <section class="demo-panel" role="tabpanel" id="demo-cleanup" aria-labelledby="demo-tab-cleanup" hidden>
        <header class="panel-head">
          <div><small>Espace disque</small><h3>Libérer de l’espace</h3></div>
          <span class="count"><b data-demo-space>{gigabytes(initialCleanup)}</b> récupérables</span>
        </header>
        <div class="cleanup-list">
          {cleanup.map((item) => (
            <label>
              <input type="checkbox" data-size={item.size} checked={item.checked}>
              <span class="icon-tile"><item.icon aria-hidden="true" /></span>
              <span><strong>{item.title}</strong><small>{item.desc}</small></span>
              <em>{gigabytes(item.size)}</em>
            </label>
          ))}
        </div>
        <button type="button" class="btn btn-primary run" data-demo-run="cleanup"><Play aria-hidden="true" />Simuler le nettoyage</button>
      </section>
    </div>
  </div>

  <dialog class="demo-dialog" data-demo-dialog aria-labelledby="demo-dialog-title">
    <small>Mode démonstration</small>
    <h3 id="demo-dialog-title" data-demo-title>Simulation en cours</h3>
    <p data-demo-detail aria-live="polite">Préparation…</p>
    <div class="track"><i data-demo-progress></i></div>
    <div class="dialog-foot">
      <b data-demo-percent>0 %</b>
      <button type="button" class="btn btn-primary btn-sm" data-demo-close disabled>Terminer</button>
    </div>
  </dialog>
</div>

<script>
  const demo = document.querySelector<HTMLElement>("[data-demo]");
  if (demo) {
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const selected = new Set<string>();
    const dialog = demo.querySelector<HTMLDialogElement>("[data-demo-dialog]")!;
    const closeButton = demo.querySelector<HTMLButtonElement>("[data-demo-close]")!;
    const cleanupBoxes = [...demo.querySelectorAll<HTMLInputElement>(".cleanup-list input")];
    const format = (value: number) => `${value.toLocaleString("fr-FR", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Go`;
    const cleanupTotal = () => cleanupBoxes.filter((box) => box.checked).reduce((sum, box) => sum + Number(box.dataset.size), 0);
    let running = false;
    let timer: number | undefined;

    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach((other) => {
        const active = other === tab;
        other.setAttribute("aria-selected", String(active));
        other.tabIndex = active ? 0 : -1;
        document.getElementById(other.getAttribute("aria-controls")!)!.hidden = !active;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        next.focus();
        selectTab(next);
      });
    });

    const renderSelection = () => {
      demo.querySelectorAll<HTMLButtonElement>("[data-demo-app]").forEach((button) => {
        button.setAttribute("aria-pressed", String(selected.has(button.dataset.demoApp!)));
      });
      demo.querySelectorAll("[data-demo-count]").forEach((element) => (element.textContent = String(selected.size)));
      demo.querySelector<HTMLElement>("[data-demo-dock]")!.hidden = selected.size === 0;
    };
    demo.querySelectorAll<HTMLButtonElement>("[data-demo-app]").forEach((button) =>
      button.addEventListener("click", () => {
        const id = button.dataset.demoApp!;
        selected.has(id) ? selected.delete(id) : selected.add(id);
        renderSelection();
      }),
    );

    const renderCleanup = () => {
      const total = cleanupTotal();
      demo.querySelector("[data-demo-space]")!.textContent = format(total);
      demo.querySelector<HTMLButtonElement>('[data-demo-run="cleanup"]')!.disabled = total === 0;
    };
    cleanupBoxes.forEach((box) => box.addEventListener("change", renderCleanup));

    const scenarios = {
      install: { title: "Installation simulée", steps: ["Préparation de la sélection", "Téléchargement depuis les sources officielles", "Installation silencieuse", "Vérification finale"] },
      update: { title: "Mise à jour simulée", steps: ["Actualisation du gestionnaire de paquets", "Mise à jour des applications", "Recherche des mises à jour système", "Vérification finale"] },
      cleanup: { title: "Nettoyage simulé", steps: ["Analyse des zones sélectionnées", "Suppression des fichiers temporaires", "Nettoyage des caches", "Calcul de l’espace récupéré"] },
    };
    const title = demo.querySelector("[data-demo-title]")!;
    const detail = demo.querySelector("[data-demo-detail]")!;
    const progress = demo.querySelector<HTMLElement>("[data-demo-progress]")!;
    const percent = demo.querySelector("[data-demo-percent]")!;

    const run = (kind: keyof typeof scenarios) => {
      const scenario = scenarios[kind];
      clearInterval(timer);
      running = true;
      title.textContent = scenario.title;
      detail.textContent = "Préparation…";
      progress.style.transform = "scaleX(0)";
      percent.textContent = "0 %";
      closeButton.disabled = true;
      dialog.showModal();

      let step = 0;
      const advance = () => {
        const value = Math.round(((step + 1) / scenario.steps.length) * 100);
        detail.textContent = scenario.steps[step];
        progress.style.transform = `scaleX(${value / 100})`;
        percent.textContent = `${value} %`;
        step++;
        if (step < scenario.steps.length) return;
        clearInterval(timer);
        setTimeout(() => {
          running = false;
          title.textContent = "Simulation terminée";
          detail.textContent = kind === "cleanup"
            ? `${format(cleanupTotal())} pourraient être récupérés sur cet exemple. Rien n’a été supprimé.`
            : "Aucune modification n’a été effectuée sur votre ordinateur.";
          closeButton.disabled = false;
          closeButton.focus();
          if (kind === "install") {
            selected.clear();
            renderSelection();
          }
        }, 450);
      };
      setTimeout(advance, 150);
      timer = window.setInterval(advance, 650);
    };

    demo.querySelectorAll<HTMLButtonElement>("[data-demo-run]").forEach((button) =>
      button.addEventListener("click", () => run(button.dataset.demoRun as keyof typeof scenarios)),
    );
    closeButton.addEventListener("click", () => dialog.close());
    // Échap ne ferme la fenêtre qu'une fois la simulation terminée.
    dialog.addEventListener("cancel", (event) => {
      if (running) event.preventDefault();
    });
  }
</script>

<style>
  .demo {
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-l);
    overflow: hidden;
  }
  .demo-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding-left: 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 13.5px;
    font-weight: 600;
  }
  .demo-bar img { width: 20px; height: 20px; }
  .win-controls { display: flex; align-self: stretch; margin-left: auto; color: var(--muted); }
  .win-controls :global(svg) { box-sizing: content-box; padding: 0 16px; height: 100%; }

  .demo-body { display: grid; grid-template-columns: 210px 1fr; min-height: 470px; }
  .demo-side {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 10px;
    border-right: 1px solid var(--border);
    background: var(--surface-2);
  }
  [role="tab"] {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 12px;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--text-2);
    font-size: 14.5px;
    font-weight: 550;
    text-align: left;
    cursor: pointer;
    position: relative;
  }
  [role="tab"] :global(svg) { width: 18px; height: 18px; flex: none; }
  [role="tab"]:hover { background: var(--surface-3); color: var(--text); }
  [role="tab"][aria-selected="true"] { background: var(--surface-3); color: var(--text); }
  [role="tab"][aria-selected="true"]::before {
    content: "";
    position: absolute;
    left: 0; top: 10px; bottom: 10px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }
  .demo-os {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--accent-text);
    font-size: 13px;
  }
  .demo-os strong, .demo-os small { display: block; }
  .demo-os strong { color: var(--text); }
  .demo-os small { color: var(--muted); }

  .demo-main { padding: 22px; min-width: 0; }
  .demo-panel { display: flex; flex-direction: column; gap: 18px; height: 100%; }
  .demo-panel[hidden] { display: none; }
  .panel-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .panel-head small {
    color: var(--accent-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .panel-head h3 { font-size: 21px; margin-top: 2px; }
  .count { color: var(--muted); font-size: 14px; white-space: nowrap; }
  .count b { color: var(--text); }

  .apps { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
  .app {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-align: left;
    cursor: pointer;
    transition: border-color .15s var(--ease), background-color .15s var(--ease);
  }
  .app:hover { border-color: var(--border-strong); background: var(--surface-2); }
  .app .logo-tile { width: 38px; height: 38px; }
  .app > span:not(.logo-tile) { flex: 1; min-width: 0; }
  .app strong, .app small { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .app strong { font-size: 14px; }
  .app small { color: var(--muted); font-size: 12.5px; }
  .app i {
    display: grid;
    place-items: center;
    width: 26px; height: 26px;
    flex: none;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--muted);
  }
  .app .i-on { display: none; }
  .app[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
  .app[aria-pressed="true"] i { border-color: var(--accent); background: var(--accent); color: var(--on-accent); }
  .app[aria-pressed="true"] .i-add { display: none; }
  .app[aria-pressed="true"] .i-on { display: block; }

  .dock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding: 12px 12px 12px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 14px;
  }
  .dock[hidden] { display: none; }
  .dock strong { color: var(--text); }

  .update-list, .cleanup-list { display: grid; gap: 10px; }
  .update-list > div, .cleanup-list label {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .update-list .icon-tile, .cleanup-list .icon-tile { width: 40px; height: 40px; margin: 0; border-radius: 11px; flex: none; }
  .update-list .icon-tile :global(svg), .cleanup-list .icon-tile :global(svg) { width: 19px; height: 19px; }
  .update-list > div > span:not(.icon-tile), .cleanup-list label > span:not(.icon-tile) { flex: 1; min-width: 0; }
  .update-list strong, .update-list small, .cleanup-list strong, .cleanup-list small { display: block; }
  .update-list strong, .cleanup-list strong { font-size: 14.5px; }
  .update-list small, .cleanup-list small { color: var(--muted); font-size: 13px; }
  .update-list em, .cleanup-list em { color: var(--text-2); font-size: 13.5px; font-style: normal; font-weight: 600; white-space: nowrap; }
  .cleanup-list label { cursor: pointer; }
  .cleanup-list label:has(input:checked) { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: var(--accent-soft); }
  .cleanup-list input { width: 18px; height: 18px; flex: none; margin: 0; accent-color: var(--accent); }
  .run { align-self: flex-start; margin-top: auto; }
  .run:disabled { opacity: .5; cursor: not-allowed; }

  .demo-dialog {
    width: min(420px, calc(100% - 32px));
    padding: 28px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-l);
  }
  .demo-dialog::backdrop { background: rgb(5 10 20 / .55); backdrop-filter: blur(4px); }
  .demo-dialog small {
    color: var(--warning);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .demo-dialog h3 { margin: 6px 0 6px; font-size: 22px; }
  .demo-dialog p { min-height: 3em; color: var(--muted); }
  .track { height: 8px; margin: 18px 0 14px; border-radius: 99px; background: var(--surface-3); overflow: hidden; }
  .track i {
    display: block;
    height: 100%;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s var(--ease);
  }
  .dialog-foot { display: flex; align-items: center; justify-content: space-between; }
  .dialog-foot button:disabled { opacity: .45; cursor: progress; }

  @media (max-width: 760px) {
    .demo-body { grid-template-columns: 1fr; min-height: 0; }
    .demo-side { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--border); padding: 8px; }
    [role="tab"] { flex: none; }
    [role="tab"][aria-selected="true"]::before { left: 12px; right: 12px; top: auto; bottom: 0; width: auto; height: 3px; }
    .demo-os { display: none; }
    .demo-main { padding: 16px; }
    .apps { grid-template-columns: 1fr; }
    .panel-head { flex-direction: column; align-items: flex-start; }
  }
</style>

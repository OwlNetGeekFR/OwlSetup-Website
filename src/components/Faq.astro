---
export type FaqItem = { question: string; answer: string };

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <div set:html={item.answer} />
    </details>
  ))}
</div>

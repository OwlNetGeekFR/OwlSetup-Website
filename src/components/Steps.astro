---
export type Step = { title: string; body: string };

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((step) => (
    <li data-reveal>
      <h3>{step.title}</h3>
      <div set:html={step.body} />
    </li>
  ))}
</ol>

<style>
  .steps {
    counter-reset: step;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    counter-increment: step;
    position: relative;
    padding: 0 0 30px 64px;
  }
  li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0; top: -2px;
    display: grid;
    place-items: center;
    width: 42px; height: 42px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface);
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
  }
  li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 21px; top: 46px; bottom: 6px;
    width: 1px;
    background: var(--border-strong);
  }
  h3 { font-size: 19px; margin-bottom: 6px; }
  div { color: var(--muted); max-width: 720px; }
  div :global(p + p) { margin-top: 8px; }
  div :global(strong) { color: var(--text-2); }
  div :global(a) { color: var(--accent-text); font-weight: 600; }
</style>

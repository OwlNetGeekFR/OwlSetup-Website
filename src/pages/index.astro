---
import BaseLayout from "../layouts/BaseLayout.astro";
import Demo from "../components/Demo.astro";
import DownloadPanel from "../components/DownloadPanel.astro";
import Faq from "../components/Faq.astro";
import Download from "@lucide/astro/icons/download";
import Play from "@lucide/astro/icons/play";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import Sparkles from "@lucide/astro/icons/sparkles";
import ArchiveRestore from "@lucide/astro/icons/archive-restore";
import PackageCheck from "@lucide/astro/icons/package-check";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import CodeXml from "@lucide/astro/icons/code-xml";
import Ban from "@lucide/astro/icons/ban";
import CircleCheck from "@lucide/astro/icons/circle-check";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Heart from "@lucide/astro/icons/heart";
import Info from "@lucide/astro/icons/info";
import GithubMark from "../components/GithubMark.astro";
import { release } from "../lib/release";
import { site } from "../lib/site";
import { homeFaq, faqJsonLd } from "../lib/faq";

const catalogLogos = ["googlechrome", "firefox", "vlc", "sevenzip", "discord", "vscode", "spotify", "steam", "obs", "libreoffice", "bitwarden", "notepadpp"];

const securityPoints = [
  "Analyse exécutée localement",
  "Historique privé pour chaque compte Windows",
  "Versions comparées avant mise à jour",
  "Documents personnels protégés",
  "Sources des éditeurs accessibles",
  "Code source consultable sur GitHub",
  "Téléchargements vérifiables par SHA-256",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      description: "Application gratuite et open source pour installer, mettre à jour et entretenir Windows.",
      inLanguage: "fr-FR",
      publisher: { "@id": `${site.url}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.author,
      url: site.authorUrl,
      logo: `${site.url}/assets/owlsetup-logo.png`,
      sameAs: ["https://github.com/OwlNetGeekFR"],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site.url}/#software`,
      name: site.name,
      url: `${site.url}/`,
      downloadUrl: release.installer.url,
      softwareVersion: release.version,
      dateModified: release.publishedIso,
      operatingSystem: "Windows 10, Windows 11",
      applicationCategory: "UtilitiesApplication",
      description: "OwlSetup installe des logiciels depuis leurs sources officielles, applique les mises à jour et aide à libérer de l’espace sur Windows.",
      isAccessibleForFree: true,
      license: site.license,
      author: { "@id": `${site.url}/#organization` },
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR", availability: "https://schema.org/InStock" },
    },
    faqJsonLd(`${site.url}/#faq`, homeFaq),
  ],
};
---
<BaseLayout
  title="OwlSetup — Installer, mettre à jour et nettoyer Windows"
  description="OwlSetup est une application Windows gratuite et open source pour installer vos logiciels, appliquer les mises à jour et libérer de l’espace facilement."
  socialTitle="OwlSetup — Entretenez Windows simplement"
  socialDescription="Installez vos logiciels, appliquez les mises à jour et libérez de l’espace avec une application gratuite et open source."
  jsonLd={jsonLd}
>
  <!-- Accueil -->
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <a class="release-pill" href={release.notesUrl}>
          <span class="badge">Nouveau</span>
          Version {release.version} disponible
          <ArrowRight size={15} aria-hidden="true" />
        </a>
        <h1>Votre ordinateur,<br><span class="gradient-text">simplement prêt.</span></h1>
        <p class="lead">Installez vos logiciels essentiels, mettez à jour vos applications et récupérez de l’espace depuis une interface claire. Vous choisissez chaque opération avant son exécution.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={release.installer.url}>
            <Download aria-hidden="true" />
            <span class="btn-stack">Télécharger pour Windows<small>Version {release.version} · {release.installer.size}</small></span>
          </a>
          <a class="btn btn-lg" href="#demo"><Play aria-hidden="true" />Essayer la démo</a>
        </div>
        <p class="hero-meta">Windows 10 et 11 · 64 bits · Gratuit · <a href="/telecharger/">Version portable et autres options</a></p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="halo"></div>
        <img class="mascot" src="/assets/owlsetup-logo.png" alt="" width="512" height="512">
        <div class="float float-a"><span class="dot green"><CircleCheck size={16} /></span><span><strong>7-Zip installé</strong><small>Source officielle</small></span></div>
        <div class="float float-b"><span class="dot blue"><RefreshCw size={16} /></span><span><strong>7 mises à jour</strong><small>Prêtes à installer</small></span></div>
        <div class="float float-c"><span class="dot cyan"><Sparkles size={16} /></span><span><strong>2,4 Go libérables</strong><small>Documents protégés</small></span></div>
      </div>
    </div>

    <div class="shell">
      <ul class="proof">
        <li><PackageCheck aria-hidden="true" /><span><strong>{site.catalogSize} logiciels</strong> au catalogue</span></li>
        <li><BadgeCheck aria-hidden="true" /><span><strong>Sources officielles</strong> WinGet et éditeurs</span></li>
        <li><CodeXml aria-hidden="true" /><span><strong>Open source</strong> code public sur GitHub</span></li>
        <li><Ban aria-hidden="true" /><span><strong>Sans publicité</strong> ni compte à créer</span></li>
      </ul>
    </div>
  </section>

  <!-- Fonctionnalités -->
  <section class="section" id="fonctionnalites">
    <div class="shell">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Tout au même endroit</span>
        <h2>Entretenez Windows simplement</h2>
        <p>OwlSetup s’appuie sur WinGet, Windows Update et les sources officielles des éditeurs. Vous voyez ce qui va se passer avant que ça se passe.</p>
      </header>

      <div class="bento">
        <article class="card bento-install" data-reveal>
          <span class="icon-tile"><Download aria-hidden="true" /></span>
          <h3>Installer des logiciels</h3>
          <p>Choisissez plusieurs applications dans un catalogue vérifié et lancez une installation groupée, sans assistants à cliquer un par un.</p>
          <ul class="logo-wall" aria-label="Exemples de logiciels du catalogue">
            {catalogLogos.map((logo) => <li class="logo-tile" data-brand={logo}><img src={`/assets/logos/${logo}.svg`} alt="" width="30" height="30" loading="lazy"></li>)}
            <li class="more">+{site.catalogSize - catalogLogos.length}</li>
          </ul>
        </article>
        <article class="card" data-reveal="1">
          <span class="icon-tile green"><RefreshCw aria-hidden="true" /></span>
          <h3>Tout mettre à jour</h3>
          <p>Applications, composants Windows et pilotes certifiés. Comparez les versions et choisissez ce que vous actualisez.</p>
        </article>
        <article class="card" data-reveal="2">
          <span class="icon-tile cyan"><Sparkles aria-hidden="true" /></span>
          <h3>Libérer de l’espace</h3>
          <p>Temporaires, caches, Corbeille et anciens composants : vous cochez, OwlSetup nettoie.</p>
        </article>
        <article class="card bento-wide" data-reveal="3">
          <span class="icon-tile violet"><ArchiveRestore aria-hidden="true" /></span>
          <h3>Gérer la quarantaine</h3>
          <p>Restaurez un ancien dossier ou confirmez sa suppression définitive, quand vous le décidez.</p>
        </article>
        <article class="card bento-new" data-reveal="4">
          <div>
            <span class="badge">Nouveautés {release.version}</span>
            <h3>Plus lisible, plus sûr</h3>
            <p>Les suppressions restent toujours soumises à votre confirmation.</p>
          </div>
          <ul class="chips">
            <li class="chip"><CircleCheck aria-hidden="true" />Configuration guidée</li>
            <li class="chip"><CircleCheck aria-hidden="true" />Centre des opérations</li>
            <li class="chip"><CircleCheck aria-hidden="true" />Nettoyage des navigateurs</li>
            <li class="chip"><CircleCheck aria-hidden="true" />Thème clair ou sombre</li>
            <li class="chip"><CircleCheck aria-hidden="true" />Tâches en arrière-plan</li>
          </ul>
        </article>
      </div>
      <p class="more-link" data-reveal><a class="link-arrow" href="/fonctionnalites/">Découvrir toutes les fonctionnalités <ArrowRight aria-hidden="true" /></a></p>
    </div>
  </section>

  <!-- Démo -->
  <section class="section section-alt" id="demo">
    <div class="shell">
      <header class="section-head center" data-reveal>
        <span class="eyebrow">Démonstration interactive</span>
        <h2>Essayez OwlSetup dans votre navigateur</h2>
        <p>Sélectionnez des logiciels, lancez une mise à jour ou un nettoyage. Tout est simulé : rien ne change sur cet ordinateur.</p>
      </header>
      <div data-reveal><Demo /></div>
    </div>
  </section>

  <!-- Prise en main -->
  <section class="section" id="prise-en-main">
    <div class="shell">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Prise en main</span>
        <h2>Prêt en trois étapes</h2>
        <p>OwlSetup vous montre ce qui va être fait avant de modifier votre ordinateur.</p>
      </header>
      <ol class="how">
        <li class="card" data-reveal><span class="how-num">1</span><h3>Installez OwlSetup</h3><p>Utilisez l’installateur recommandé ou choisissez la version portable.</p></li>
        <li class="card" data-reveal="1"><span class="how-num">2</span><h3>Sélectionnez une action</h3><p>Logiciels, mises à jour, nettoyage ou diagnostic : rien ne démarre seul.</p></li>
        <li class="card" data-reveal="2"><span class="how-num">3</span><h3>Gardez le contrôle</h3><p>Vérifiez le récapitulatif et suivez la progression jusqu’au rapport final.</p></li>
      </ol>
      <p class="requirements" data-reveal><Info size={18} aria-hidden="true" /><span><strong>Configuration requise :</strong> Windows 10 ou 11, 64 bits, connexion Internet. Droits administrateur pour certaines actions.</span></p>
    </div>
  </section>

  <!-- Sécurité -->
  <section class="section" id="securite">
    <div class="shell security">
      <div data-reveal>
        <span class="eyebrow">Une approche responsable</span>
        <h2>Vous gardez le contrôle.</h2>
        <p>Le tableau de santé analyse localement le disque et les versions disponibles. Chaque opération sensible est confirmée avant son lancement, et vos données restent sur votre PC.</p>
        <div class="security-links">
          <a class="btn" href="/securite/"><ShieldCheck aria-hidden="true" />Sécurité et confidentialité</a>
          <a class="btn btn-ghost" href={site.repo}><GithubMark size={18} />Voir le code source</a>
        </div>
      </div>
      <ul class="card checklist security-list" data-reveal="1">
        {securityPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <!-- Téléchargement -->
  <section class="section section-alt" id="telecharger">
    <div class="shell">
      <header class="section-head center" data-reveal>
        <span class="eyebrow">Télécharger</span>
        <h2>La version stable est prête</h2>
        <p>Les fichiers proviennent directement de la Release GitHub officielle, avec leur empreinte SHA-256.</p>
      </header>
      <DownloadPanel />
      <p class="platform-note" data-reveal>Linux et macOS sont en préparation et ne proposent pas encore de téléchargement.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="shell faq-layout">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Avant de commencer</h2>
        <p>Une autre question ? Le <a class="inline-link" href="/guide-installation/">guide d’installation</a> couvre les messages courants, et l’équipe répond sur <a class="inline-link" href={site.issues}>GitHub</a>.</p>
      </header>
      <div data-reveal="1"><Faq items={homeFaq} /></div>
    </div>
  </section>

  <!-- Soutien -->
  <section class="shell support" data-reveal>
    <span class="support-icon"><Heart aria-hidden="true" /></span>
    <div>
      <h2>OwlSetup reste gratuit et open source.</h2>
      <p>Un don facultatif aide à financer les tests, l’hébergement et la future signature numérique. Le paiement est entièrement géré sur Ko-fi.</p>
    </div>
    <a class="btn" href={site.kofi} target="_blank" rel="noopener">Soutenir sur Ko-fi <ArrowUpRight aria-hidden="true" /></a>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-top: clamp(40px, 7vw, 88px);
    background:
      radial-gradient(50% 60% at 78% 30%, var(--glow), transparent 70%),
      linear-gradient(to bottom, var(--bg-soft), var(--bg));
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    align-items: center;
    gap: 40px;
  }
  .release-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 14px;
    font-weight: 550;
    box-shadow: var(--shadow-s);
    transition: border-color .15s var(--ease);
  }
  .release-pill:hover { border-color: var(--accent); }
  h1 {
    margin: 22px 0 20px;
    font-size: clamp(40px, 5.8vw, 68px);
    line-height: 1.03;
    letter-spacing: -.04em;
  }
  h1 .gradient-text { white-space: nowrap; }
  .lead { max-width: 580px; color: var(--text-2); font-size: clamp(17px, 2vw, 19px); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-meta { margin-top: 18px; color: var(--muted); font-size: 14.5px; }
  .hero-meta a { color: var(--accent-text); font-weight: 600; }
  .hero-meta a:hover { text-decoration: underline; }

  .hero-visual { position: relative; display: grid; place-items: center; min-height: 460px; }
  .halo {
    position: absolute;
    width: min(440px, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 68%);
  }
  .mascot { position: relative; width: min(400px, 88%); height: auto; filter: drop-shadow(0 30px 40px rgb(20 50 140 / .3)); }
  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-m);
    font-size: 13.5px;
    line-height: 1.3;
  }
  .float strong, .float small { display: block; }
  .float small { color: var(--muted); font-size: 12px; }
  .dot { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; }
  .dot.green { background: var(--success-soft); color: var(--success); }
  .dot.blue { background: var(--accent-soft); color: var(--accent-text); }
  .dot.cyan { background: color-mix(in srgb, var(--cyan) 15%, transparent); color: var(--cyan); }
  .float-a { top: 12%; left: 0; }
  .float-b { top: 44%; right: -2%; }
  .float-c { bottom: 10%; left: 8%; }
  @media (prefers-reduced-motion: no-preference) {
    .float { animation: float 7s ease-in-out infinite; }
    .float-b { animation-delay: -2.3s; }
    .float-c { animation-delay: -4.6s; }
    @keyframes float { 50% { transform: translateY(-8px); } }
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .proof li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 24px 20px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.4;
  }
  .proof li + li { border-left: 1px solid var(--border); }
  .proof :global(svg) { flex: none; width: 22px; height: 22px; color: var(--accent-text); }
  .proof strong { display: block; color: var(--text); font-size: 15.5px; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { min-height: 380px; order: -1; display: none; }
    .proof { grid-template-columns: repeat(2, 1fr); }
    .proof li:nth-child(3) { border-left: 0; }
    .proof li:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
  @media (max-width: 520px) {
    .proof { grid-template-columns: 1fr; }
    .proof li + li { border-left: 0; border-top: 1px solid var(--border); }
    .proof li { padding: 16px 4px; }
  }

  /* ---------- Fonctionnalités ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .bento-install { grid-row: span 2; display: flex; flex-direction: column; }
  .bento-wide { grid-column: span 2; }
  .bento-new {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background:
      radial-gradient(80% 120% at 100% 100%, var(--glow), transparent 70%),
      var(--surface);
  }
  .bento-new h3 { margin-top: 12px; }
  .bento-new .chips { margin: 0; padding: 0; list-style: none; max-width: 420px; }
  .logo-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: 10px;
    margin: auto 0 0 !important;
    padding-top: 26px !important;
  }
  .logo-wall li { display: grid; place-items: center; aspect-ratio: 1; border-radius: 12px; }
  .logo-wall li::before { display: none; }
  .logo-wall .more {
    border: 1px dashed var(--border-strong);
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }
  .more-link { margin-top: 28px; }

  @media (max-width: 960px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .bento-install { grid-row: auto; grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .bento { grid-template-columns: 1fr; }
    .bento-wide { grid-column: auto; }
  }

  /* ---------- Prise en main ---------- */
  .how {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how-num {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .requirements {
    display: flex;
    gap: 12px;
    margin-top: 18px;
    padding: 16px 20px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
  }
  .requirements :global(svg) { flex: none; margin-top: 3px; color: var(--accent-text); }
  .requirements strong { color: var(--text); }
  @media (max-width: 860px) { .how { grid-template-columns: 1fr; } }

  /* ---------- Sécurité ---------- */
  .security {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .security h2 { margin: 14px 0 16px; font-size: clamp(30px, 4.2vw, 44px); }
  .security p { color: var(--muted); font-size: 18px; }
  .security-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .security-list { margin: 0 !important; padding: 28px !important; gap: 14px !important; }
  .security-list li { font-weight: 550; }
  @media (max-width: 860px) { .security { grid-template-columns: 1fr; } }

  /* ---------- Téléchargement ---------- */
  .platform-note { margin-top: 18px; color: var(--muted); font-size: 14.5px; text-align: center; }

  /* ---------- FAQ ---------- */
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .faq-layout .section-head { position: sticky; top: calc(var(--header-h) + 24px); }
  .inline-link { color: var(--accent-text); font-weight: 600; }
  .inline-link:hover { text-decoration: underline; }
  @media (max-width: 860px) {
    .faq-layout { grid-template-columns: 1fr; }
    .faq-layout .section-head { position: static; margin-bottom: 0; }
  }

  /* ---------- Soutien ---------- */
  .support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 28px;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
  }
  .support > div { flex: 1 1 380px; }
  .support h2 { font-size: 22px; margin-bottom: 6px; }
  .support p { color: var(--muted); }
  .support-icon {
    display: grid;
    place-items: center;
    width: 52px; height: 52px;
    border-radius: 16px;
    background: color-mix(in srgb, #e0457b 14%, transparent);
    color: #e0457b;
  }
</style>
